import { Button, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { AppState, Texts, Page, FileRow, CandidateRow, PlayerRow } from "state.slint";
import { Glyph, IconButton } from "components.slint";
import { LibraryPage } from "library.slint";
import { SettingsPage } from "settings.slint";
import { WhatsNewDialog, ReportDialog, ModelPromptDialog, CrashDialog } from "dialogs.slint";

export { AppState, Texts, FileRow, CandidateRow, PlayerRow, Page }

export component AppWindow inherits Window {
    title: "SubMagician";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 860px;
    min-height: 520px;
    background: Theme.content;

    property <bool> update-banner: !AppState.update-dismissed && (AppState.update-state == 2 || AppState.update-state == 3 || AppState.update-state == 4 || AppState.update-state == 7);

    VerticalLayout {
            // Top bar: where you are, opening videos, settings. In Settings: back.
            HorizontalLayout {
                height: 48px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                if AppState.page == Page.settings: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.back;
                        label: @tr("Back");
                        clicked => { AppState.page = Page.library; }
                    }
                }
                if AppState.page == Page.settings: Text {
                    text: @tr("Settings");
                    font-size: 17px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if AppState.page == Page.library: VerticalLayout {
                    alignment: center;
                    Image {
                        source: Icons.logo;
                        width: 24px;
                        height: 24px;
                    }
                }
                if AppState.page == Page.library: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 0px;
                    Text {
                        text: AppState.folder == "" ? "SubMagician" : AppState.folder-name;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if AppState.folder != "": Text {
                        text: AppState.folder;
                        font-size: 11px;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
                if AppState.page == Page.library && AppState.folder != "": VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Open folder…");
                        icon: Icons.folder-open;
                        colorize-icon: true;
                        enabled: !AppState.busy;
                        clicked => { AppState.choose-folder(); }
                    }
                }
                if AppState.page == Page.library && AppState.folder != "": VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.video;
                        label: @tr("Open videos…");
                        enabled: !AppState.busy;
                        clicked => { AppState.choose-videos(); }
                    }
                }
                if AppState.page == Page.library: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.settings;
                        label: @tr("Settings");
                        badge: AppState.update-state == 2 || AppState.update-state == 3 || AppState.update-state == 7;
                        clicked => { AppState.page = Page.settings; }
                    }
                }
            }

            if update-banner: Rectangle {
                background: Palette.accent-background.transparentize(0.85);
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { source: Icons.update; color: Palette.accent-background; }
                    }
                    Text {
                        text: AppState.update-state == 4 ? @tr("Downloading SubMagician {}…", AppState.update-version)
                            : AppState.update-state == 7 ? Texts.managed-update(AppState.update-version, AppState.update-flatpak)
                            : @tr("SubMagician {} is available.", AppState.update-version);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if AppState.update-state == 2: Button {
                        text: @tr("Restart and update");
                        primary: true;
                        clicked => { AppState.install-update(); }
                    }
                    if AppState.update-state == 3: Button {
                        text: @tr("Download");
                        primary: true;
                        clicked => { AppState.open-release(); }
                    }
                    Button {
                        text: @tr("Release notes");
                        clicked => { AppState.open-release(); }
                    }
                    if AppState.update-state != 4: Button {
                        text: @tr("Later");
                        clicked => { AppState.update-dismissed = true; }
                    }
                }
            }

            if AppState.page == Page.library: LibraryPage {
                vertical-stretch: 1;
            }
            if AppState.page == Page.settings: SettingsPage {
                vertical-stretch: 1;
            }

            // Status bar
            Rectangle {
                height: 28px;
                background: Theme.sidebar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.tone-color(Texts.status-tone(AppState.status-kind));
                        }
                    }
                    Text {
                        text: Texts.status(AppState.status-kind, AppState.status-a, AppState.status-b, AppState.status-detail);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        font-size: 12px;
                    }
                    if AppState.busy: ProgressIndicator {
                        width: 180px;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        progress: AppState.progress;
                        indeterminate: AppState.progress <= 0;
                    }
                }
            }
    }

    if AppState.whats-new-visible: WhatsNewDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.model-prompt-visible: ModelPromptDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.crash-visible: CrashDialog {
        width: root.width;
        height: root.height;
    }
    // Last, so it opens over the crash dialog it is started from.
    if AppState.report-visible: ReportDialog {
        width: root.width;
        height: root.height;
    }
}
