import { Palette } from "std-widgets.slint";
import { Theme, Icons, Flags } from "theme.slint";
import { FileRow, CandidateRow, Texts } from "state.slint";

// A monochrome icon tinted like text.
export component Glyph inherits Image {
    in property <brush> color: Palette.foreground;
    in property <length> size: 16px;
    width: size;
    height: size;
    colorize: color;
    image-fit: contain;
}

// A rounded panel with an optional title row.
export component Card inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <length> inner-padding: 14px;
    in property <length> inner-spacing: 10px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;

    VerticalLayout {
        padding: root.inner-padding;
        spacing: root.inner-spacing;
        if root.title != "": HorizontalLayout {
            spacing: 8px;
            if root.has-icon: VerticalLayout {
                alignment: center;
                Glyph { source: root.icon; size: 18px; color: Palette.accent-background; }
            }
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        @children
    }
}

// One setting: a title, an optional explanation, and the control on the right.
export component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.title; wrap: word-wrap; }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        HorizontalLayout {
            spacing: 8px;
            @children
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.idle;
    border-radius: 4px;
    background: tone.transparentize(0.85);
    height: 20px;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.tone;
        }
    }
}

// A highlighted hint with an icon.
export component Note inherits Rectangle {
    in property <string> text;
    in property <image> icon: Icons.info;
    in property <color> tone: Palette.accent-background;
    border-radius: 6px;
    background: tone.transparentize(0.88);
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            Glyph { source: root.icon; color: root.tone; }
        }
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: 12px;
            horizontal-stretch: 1;
        }
    }
}

export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <length> icon-size: 48px;
    alignment: center;
    spacing: 10px;
    vertical-stretch: 1;
    HorizontalLayout {
        alignment: center;
        Glyph { source: root.icon; size: root.icon-size; color: Theme.muted; }
    }
    Text {
        text: root.title;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.subtitle != "": HorizontalLayout {
        alignment: center;
        Text {
            text: root.subtitle;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 460px;
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        @children
    }
}

export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 8px;
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 26px;
            font-weight: 600;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        HorizontalLayout {
            spacing: 8px;
            @children
        }
    }
}

// A small round icon button with a tooltip-like accessible label.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    // A dot in the corner, e.g. an update is available.
    in property <bool> badge;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    background: touch.has-hover && root.enabled ? Theme.card-hover : transparent;
    Glyph {
        source: root.icon;
        size: 16px;
        color: root.enabled ? Palette.foreground : Theme.muted;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.label != "": Tooltip {
        text: @markdown("\{root.label}");
    }
    if root.badge: Rectangle {
        x: parent.width - 10px;
        y: 4px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Palette.accent-background;
    }
}

// A language as its flag (the code when there is no flag for it).
export component LangFlag inherits HorizontalLayout {
    in property <string> code;
    in property <bool> faded;
    if Flags.has(root.code): Rectangle {
        width: 20px;
        height: 15px;
        border-radius: 2px;
        clip: true;
        opacity: root.faded ? 0.45 : 1;
        accessible-role: text;
        accessible-label: root.code;
        Image {
            width: parent.width;
            height: parent.height;
            source: Flags.of(root.code);
            image-fit: fill;
        }
        Rectangle {
            border-radius: 2px;
            border-width: 1px;
            border-color: Theme.border;
        }
    }
    if !Flags.has(root.code): Badge {
        text: root.code;
        tone: Theme.idle;
        opacity: root.faded ? 0.6 : 1;
    }
}

// Several languages as flags in a row.
export component LangFlags inherits HorizontalLayout {
    in property <[string]> codes;
    in property <bool> faded;
    spacing: 4px;
    for code in root.codes: VerticalLayout {
        alignment: center;
        LangFlag { code: code; faded: root.faded; }
    }
}

// One video in the library list.
// A thin bar for a job's progress (0..1).
export component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: Theme.border;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: Palette.accent-background;
        animate width { duration: 200ms; }
    }
}

export component FileCard inherits Rectangle {
    in property <FileRow> item;
    in property <bool> selected;
    callback clicked();

    property <int> tone: Texts.file-tone(item.state);
    property <color> tone-color: Theme.tone-color(tone);

    height: 50px;
    clip: true;
    border-radius: 6px;
    background: selected ? Palette.accent-background.transparentize(0.86) : touch.has-hover ? Theme.card-hover : transparent;
    animate background { duration: 100ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.tone-color.transparentize(0.85);
                Glyph {
                    size: 16px;
                    color: root.tone-color;
                    source: tone == 2 ? Icons.done : tone == 4 ? Icons.error : tone == 3 ? Icons.warning : tone == 1 ? Icons.sync : Icons.video;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.item.name;
                overflow: elide;
                font-weight: 600;
                font-size: 13px;
            }
            Text {
                text: Texts.file-state(root.item.state, root.item.detail)
                    + (root.item.progress >= 0 ? "  " + round(root.item.progress * 100) + "%" : "");
                overflow: elide;
                font-size: 11px;
                color: root.tone == 0 ? Theme.muted : root.tone-color;
            }
            if root.item.progress >= 0: ProgressBar {
                value: root.item.progress;
            }
        }

        // Subtitles next to the video as flags; the ones inside it faded after a film icon.
        HorizontalLayout {
            alignment: end;
            horizontal-stretch: 0;
            spacing: 6px;
            LangFlags { codes: root.item.existing-langs; }
            if root.item.embedded-langs.length > 0: HorizontalLayout {
                spacing: 3px;
                VerticalLayout {
                    alignment: center;
                    Glyph { source: Icons.video; size: 12px; color: Theme.muted; }
                }
                LangFlags { codes: root.item.embedded-langs; faded: true; }
            }
            if root.item.existing == "" && root.item.embedded == "": VerticalLayout {
                alignment: center;
                Badge {
                    text: @tr("no subtitle");
                    tone: Theme.warn;
                }
            }
        }
    }
}

// One subtitle a source offers: how well it fits, its name and what is known about it.
export component CandidateCard inherits Rectangle {
    in property <CandidateRow> item;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();

    property <color> fit: Theme.tone-color(Texts.match-tone(item.score, item.hash-match));

    height: 46px;
    border-radius: 6px;
    background: selected ? Palette.accent-background.transparentize(0.86) : touch.has-hover ? Theme.card-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            LangFlag { code: root.item.language; }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.item.release == "" ? @tr("(no release name)") : root.item.release;
                overflow: elide;
                font-size: 13px;
            }
            Text {
                text: root.item.provider
                    + (root.item.hash-match ? " · " + @tr("made for this file") : "")
                    + (root.item.fps != "" ? " · " + root.item.fps + " fps" : "")
                    + (root.item.hearing-impaired ? " · " + @tr("hearing impaired") : "")
                    + (root.item.machine ? " · " + @tr("machine translated") : "")
                    + " · " + @tr("{} downloads", root.item.downloads);
                overflow: elide;
                font-size: 11px;
                color: Theme.muted;
            }
        }

        VerticalLayout {
            alignment: center;
            Badge {
                text: Texts.match-label(root.item.score, root.item.hash-match);
                tone: root.fit;
            }
        }
    }
}

// A small "?" next to a control: hovering it explains the control.
export component HelpTip inherits Rectangle {
    in property <styled-text> text;
    width: 18px;
    height: 18px;
    accessible-role: AccessibleRole.text;
    Glyph {
        source: Icons.question;
        size: 16px;
        color: touch.has-hover ? Palette.accent-background : Theme.muted;
    }
    touch := TouchArea { mouse-cursor: help; }
    Tooltip {
        text: root.text;
    }
}
