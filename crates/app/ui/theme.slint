    out property <image> search: @image-url("icons/search.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> stop: @image-url("icons/stop.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> eye: @image-url("icons/eye.svg");
    out property <image> mic: @image-url("icons/mic.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> sync: @image-url("icons/sync.svg");
    out property <image> restore: @image-url("icons/restore.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> warning: @image-url("icons/warning.svg");
    out property <image> error: @image-url("icons/error.svg");
    out property <image> plug: @image-url("icons/plug.svg");
    out property <image> bug: @image-url("icons/bug.svg");
    out property <image> update: @image-url("icons/update.svg");
    out property <image> captions: @image-url("icons/captions.svg");
    out property <image> speaker: @image-url("icons/speaker.svg");
    out property <image> clock: @image-url("icons/clock.svg");
    out property <image> globe: @image-url("icons/globe.svg");
    out property <image> person: @image-url("icons/person.svg");
