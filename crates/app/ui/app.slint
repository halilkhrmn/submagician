import { Button, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { AppState, Texts, Page, FileRow, CandidateRow, PlayerRow } from "state.slint";
import { NavItem, Glyph } from "components.slint";
import { LibraryPage } from "library.slint";
import { PlayersPage } from "players.slint";
import { SettingsPage } from "settings.slint";
import { WhatsNewDialog, ReportDialog } from "dialogs.slint";

export { AppState, Texts, FileRow, CandidateRow, PlayerRow, Page }

export component AppWindow inherits Window {
    title: "SubMagician";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 1240px;
    preferred-height: 780px;
    min-width: 940px;
    min-height: 560px;
    background: Theme.content;

    property <bool> update-banner: !AppState.update-dismissed && (AppState.update-state == 2 || AppState.update-state == 3 || AppState.update-state == 4);

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 220px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                HorizontalLayout {
                    padding: 8px;
                    padding-bottom: 20px;
                    spacing: 10px;
                    Image {
                        source: Icons.logo;
                        width: 28px;
                        height: 28px;
                    }
                    Text {
                        text: "SubMagician";
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                NavItem {
                    icon: Icons.library;
                    label: @tr("Library");
                    selected: AppState.page == Page.library;
                    clicked => { AppState.page = Page.library; }
                }
                NavItem {
                    icon: Icons.plug;
                    label: @tr("Player plugins");
                    selected: AppState.page == Page.players;
                    clicked => { AppState.page = Page.players; }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem {
                    icon: Icons.settings;
                    label: @tr("Settings");
                    selected: AppState.page == Page.settings;
                    badge: AppState.update-state == 2 || AppState.update-state == 3;
                    clicked => { AppState.page = Page.settings; }
                }
            }
        }

        // Content
        VerticalLayout {
            horizontal-stretch: 1;

            if update-banner: Rectangle {
                background: Palette.accent-background.transparentize(0.85);
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { source: Icons.update; color: Palette.accent-background; }
                    }
                    Text {
                        text: AppState.update-state == 4 ? @tr("Downloading SubMagician {}…", AppState.update-version)
                            : @tr("SubMagician {} is available.", AppState.update-version);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if AppState.update-state == 2: Button {
                        text: @tr("Restart and update");
                        primary: true;
                        clicked => { AppState.install-update(); }
                    }
                    if AppState.update-state == 3: Button {
                        text: @tr("Download");
                        primary: true;
                        clicked => { AppState.open-release(); }
                    }
                    Button {
                        text: @tr("Release notes");
                        clicked => { AppState.open-release(); }
                    }
                    if AppState.update-state != 4: Button {
                        text: @tr("Later");
                        clicked => { AppState.update-dismissed = true; }
                    }
                }
            }

            if AppState.page == Page.library: LibraryPage {
                vertical-stretch: 1;
            }
            if AppState.page == Page.players: PlayersPage {
                vertical-stretch: 1;
            }
            if AppState.page == Page.settings: SettingsPage {
                vertical-stretch: 1;
            }

            // Status bar
            Rectangle {
                height: 32px;
                background: Theme.sidebar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.tone-color(Texts.status-tone(AppState.status-kind));
                        }
                    }
                    Text {
                        text: Texts.status(AppState.status-kind, AppState.status-a, AppState.status-b, AppState.status-detail);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        font-size: 12px;
                    }
                    if AppState.busy: ProgressIndicator {
                        width: 180px;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        progress: AppState.progress;
                        indeterminate: AppState.progress <= 0;
                    }
                }
            }
        }
    }

    if AppState.whats-new-visible: WhatsNewDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.report-visible: ReportDialog {
        width: root.width;
        height: root.height;
    }
}
