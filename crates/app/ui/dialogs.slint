import { Button, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { AppState } from "state.slint";
import { Glyph } from "components.slint";

// Shown once after an update: the notes of the versions since the last start (changelog/en.md,
// built into the app). Also from Settings → Updates.
export component WhatsNewDialog inherits Rectangle {
    background: #00000080;
    TouchArea {
        clicked => { AppState.whats-new-visible = false; }
    }

    Rectangle {
        width: min(600px, root.width - 48px);
        height: min(440px, root.height - 48px);
        border-radius: 10px;
        background: Theme.content;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                Image {
                    source: Icons.logo;
                    width: 36px;
                    height: 36px;
                }
                Text {
                    text: @tr("What's new in SubMagician {}", AppState.version);
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-right: 12px;
                    Text {
                        text: AppState.whats-new;
                        wrap: word-wrap;
                        font-size: 14px;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Got it");
                    primary: true;
                    clicked => { AppState.whats-new-visible = false; }
                }
            }
        }
    }
}

// "Report a problem": shows exactly what would be sent, then opens a GitHub issue or an e-mail.
// Nothing leaves the computer unless one of those buttons is pressed.
export component ReportDialog inherits Rectangle {
    background: #00000080;
    // Modal: clicks outside do nothing, so a half-written note is not lost.
    TouchArea { }

    Rectangle {
        width: min(720px, root.width - 48px);
        height: min(640px, root.height - 48px);
        border-radius: 10px;
        background: Theme.content;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }

        VerticalLayout {
            padding: 22px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Glyph { source: Icons.bug; size: 22px; }
                }
                Text {
                    text: @tr("Report a problem");
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: @tr("What happened? A sentence or two helps a lot (optional).");
                font-size: 12px;
                color: Theme.muted;
            }
            LineEdit {
                text <=> AppState.report-note;
                placeholder-text: @tr("e.g. Sync to audio froze on a 2-hour film");
            }
            Text {
                text: @tr("This is what will be shared: the version, your system, a few settings and the recent log (file names of your videos may be in it). No passwords or API keys.");
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
            TextEdit {
                text: AppState.report-text;
                read-only: true;
                font-size: 11px;
                vertical-stretch: 1;
            }
            if AppState.report-saved-path != "": Text {
                text: @tr("Full report saved as {}", AppState.report-saved-path);
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
            Text {
                text: @tr("Have a GitHub account? Open an issue and drag the saved file into it. No account? Send it by e-mail to {} and attach the saved file.", AppState.support-email);
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: @tr("Show file");
                    icon: Icons.folder;
                    colorize-icon: true;
                    clicked => { AppState.report-show-file(); }
                }
                Button {
                    text: @tr("Send by e-mail");
                    icon: Icons.mail;
                    colorize-icon: true;
                    clicked => { AppState.report-email(); }
                }
                Button {
                    text: @tr("Open a GitHub issue");
                    icon: Icons.open;
                    colorize-icon: true;
                    primary: true;
                    clicked => { AppState.report-github(); }
                }
                Button {
                    text: @tr("Close");
                    clicked => { AppState.report-visible = false; }
                }
            }
        }
    }
}

// A small modal box with an icon, a title, a message and buttons (the children).
component Prompt inherits Rectangle {
    in property <image> icon;
    in property <color> tone: Theme.brand;
    in property <string> title;
    in property <string> message;
    in property <string> detail;
    background: #00000080;
    TouchArea { }

    Rectangle {
        width: min(480px, root.width - 48px);
        height: box.preferred-height;
        border-radius: 10px;
        background: Theme.content;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }

        box := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.tone.transparentize(0.85);
                        Glyph { source: root.icon; size: 22px; color: root.tone; }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        font-size: 17px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.message;
                        wrap: word-wrap;
                    }
                    if root.detail != "": Text {
                        text: root.detail;
                        font-size: 11px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                @children
            }
        }
    }
}

// "Write from speech" (or the setting to write subtitles from the audio) needs a speech model that is
// not downloaded yet: ask here instead of sending the user to Settings.
export component ModelPromptDialog inherits Prompt {
    icon: Icons.mic;
    title: @tr("Download the speech model?");
    message: @tr("Writing a subtitle from the audio needs Whisper's speech model, {}. It is downloaded once and runs on this computer. The model can be changed in Settings → Speech.", AppState.model-prompt-name);
    Button {
        text: @tr("Not now");
        clicked => { AppState.model-prompt-visible = false; }
    }
    Button {
        text: @tr("Download and continue");
        icon: Icons.download;
        colorize-icon: true;
        primary: true;
        clicked => {
            AppState.model-prompt-visible = false;
            AppState.model-prompt-accept();
        }
    }
}

// The background process died: say it plainly and offer to report it.
export component CrashDialog inherits Prompt {
    icon: Icons.sad;
    tone: Theme.error;
    title: @tr("Sorry, something went wrong");
    message: AppState.crash-cpu
        ? @tr("SubMagician stopped because this computer's processor does not support an instruction the task needs. Other features keep working. Please tell us, so we can make it work on your computer.")
        : @tr("SubMagician's background task stopped unexpectedly. The app is fine and the task can be tried again. Telling us about it helps fix it; the report shows you everything before anything is sent.");
    detail: AppState.crash-detail;
    Button {
        text: @tr("Close");
        clicked => { AppState.crash-visible = false; }
    }
    Button {
        text: @tr("Report it");
        icon: Icons.bug;
        colorize-icon: true;
        primary: true;
        clicked => {
            AppState.crash-visible = false;
            AppState.report-problem();
            AppState.report-note = AppState.crash-cpu ? "Crash: the processor lacks an instruction (" + AppState.crash-detail + ")"
                : "Crash of the background task (" + AppState.crash-detail + ")";
        }
    }
}
