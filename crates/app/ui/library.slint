import { Button, LineEdit, CheckBox, ListView, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { AppState, Texts } from "state.slint";
import { Card, EmptyState, FileCard, CandidateCard, Glyph, Badge, ProgressBar, LangFlags, IconButton, HelpTip, HelpButton } from "components.slint";

// The selected video: what it has, the subtitles the sources offer, and its timing.
component DetailsPanel inherits VerticalLayout {
    property <int> index: AppState.selected-file;
    property <bool> has-file: index >= 0 && index < AppState.files.length;
    property <bool> has-subtitle: has-file && AppState.files[index].existing != "";
    // The timing tools are folded away until asked for.
    property <bool> timing-open;
    spacing: 10px;

    if !has-file: Card {
        vertical-stretch: 1;
        EmptyState {
            icon: Icons.captions;
            icon-size: 40px;
            title: @tr("Pick a video");
            subtitle: @tr("Its subtitles show up here: what it has, what the sources offer, and its timing.");
        }
    }

    // What the video is and has: two lines.
    if has-file: Card {
        inner-padding: 10px;
        inner-spacing: 4px;
        HorizontalLayout {
            spacing: 2px;
            Text {
                text: AppState.files[index].name;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: Icons.play;
                label: @tr("Play the video");
                clicked => { AppState.play(index); }
            }
            IconButton {
                icon: Icons.folder;
                label: @tr("Show it in its folder");
                clicked => { AppState.reveal(index); }
            }
            if AppState.files[index].embedded != "": IconButton {
                icon: Icons.sync;
                label: @tr("Use the subtitle inside the video (saved as a file, synced)");
                enabled: !AppState.busy;
                clicked => { AppState.use-embedded(index); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: Texts.file-state(AppState.files[index].state, AppState.files[index].detail)
                    + (AppState.files[index].progress >= 0 ? "  " + round(AppState.files[index].progress * 100) + "%" : "");
                color: Theme.tone-color(Texts.file-tone(AppState.files[index].state));
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            LangFlags { codes: AppState.files[index].existing-langs; }
            if AppState.files[index].embedded != "": HorizontalLayout {
                spacing: 3px;
                VerticalLayout {
                    alignment: center;
                    Glyph { source: Icons.video; size: 12px; color: Theme.muted; }
                }
                LangFlags { codes: AppState.files[index].embedded-langs; faded: true; }
            }
        }
        if AppState.files[index].progress >= 0: ProgressBar {
            value: AppState.files[index].progress;
        }
    }

    if has-file: Card {
        vertical-stretch: 1;
        inner-spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Glyph { source: Icons.captions; size: 18px; color: Palette.accent-background; }
            }
            Text {
                text: @tr("Subtitles found");
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                HelpTip {
                    text: @tr("How well each subtitle fits this video, best first.\n\nExact: made for this very file, so its timing fits.\nGood: the same release (group and source).\nFair: the same kind of release.\nWeak: only the name matches; syncing to the audio usually fixes its timing.");
                }
            }
            IconButton {
                icon: Icons.refresh;
                label: @tr("Search the sources again");
                enabled: !AppState.busy;
                clicked => { AppState.search-file(index); }
            }
        }
        search-as-edit := LineEdit {
            enabled: !AppState.busy;
            placeholder-text: @tr("Wrong film? Type its name and press Enter (e.g. The Office US S03E07)");
            accepted(text) => { AppState.search-as(index, text); }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 100px;
            if AppState.candidates-loading: EmptyState {
                icon: Icons.search;
                icon-size: 28px;
                title: @tr("Searching…");
            }
            if !AppState.candidates-loading && AppState.candidates.length == 0: EmptyState {
                icon: Icons.captions;
                icon-size: 28px;
                title: AppState.files[index].state == 0 ? @tr("Not searched yet") : @tr("No subtitles found");
                subtitle: AppState.files[index].state == 0 ? @tr("Selecting a video searches for it.")
                    : @tr("Try \"Search as…\" with the show or film name, or create one from the video's audio.");
            }
            ListView {
                for row[i] in AppState.candidates: CandidateCard {
                    item: row;
                    selected: i == AppState.selected-candidate;
                    clicked => { AppState.selected-candidate = i; }
                    double-clicked => {
                        AppState.selected-candidate = i;
                        if !AppState.busy { AppState.download-candidate(i); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            HelpButton {
                text: @tr("Create subtitle from audio");
                icon: Icons.mic;
                enabled: !AppState.busy;
                help: @tr("No subtitle fits? SubMagician listens to the video's audio and writes the subtitle itself with Whisper, on this computer. It takes a few minutes; the first time it downloads the speech model.");
                clicked => { AppState.generate(index); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Download");
                icon: Icons.download;
                colorize-icon: true;
                primary: true;
                enabled: !AppState.busy && AppState.selected-candidate >= 0;
                clicked => { AppState.download-candidate(AppState.selected-candidate); }
                Tooltip {
                    text: @markdown("\{@tr("Saves the selected subtitle next to the video (or double-click it).")}");
                }
            }
        }
    }

    // Timing: one header line, the tools open with it.
    if has-file && has-subtitle: Card {
        inner-padding: 10px;
        inner-spacing: 8px;
        Rectangle {
            height: 28px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.timing-open = !root.timing-open; }
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Glyph { source: Icons.clock; size: 16px; color: Palette.accent-background; }
                }
                Text {
                    text: @tr("Timing");
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: root.timing-open ? "" : @tr("Subtitle out of sync? Fix it here.");
                    font-size: 11px;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Glyph { source: root.timing-open ? Icons.chevron-up : Icons.chevron-down; size: 16px; }
                }
            }
        }
        if root.timing-open: HorizontalLayout {
            spacing: 6px;
            HelpButton {
                text: @tr("Sync to the audio");
                icon: Icons.speaker;
                horizontal-stretch: 1;
                enabled: !AppState.busy;
                help: @tr("Listens to the video and moves the subtitle to the speech: offset, frame rate, cut scenes. It is changed only when it fits better.");
                clicked => { AppState.sync-audio(index); }
            }
            HelpButton {
                text: @tr("Copy timing…");
                icon: Icons.sync;
                horizontal-stretch: 1;
                enabled: !AppState.busy;
                help: @tr("Pick another subtitle file that is in sync with this video, in any language: its timing is copied to this one.");
                clicked => { AppState.sync-reference(index); }
            }
        }
        if root.timing-open: HorizontalLayout {
            spacing: 4px;
            for step in [-1000, -100, 100, 1000]: Button {
                text: (step > 0 ? "+" : "−") + abs(step / 1000) + " s";
                horizontal-stretch: 1;
                enabled: !AppState.busy;
                clicked => { AppState.shift(index, step); }
                Tooltip {
                    text: @markdown("\{step < 0 ? @tr("Show the subtitle earlier") : @tr("Show the subtitle later")}");
                }
            }
            IconButton {
                icon: Icons.restore;
                label: @tr("Undo: put back the subtitle that was there before");
                enabled: !AppState.busy;
                clicked => { AppState.restore(index); }
            }
        }
    }
}

export component LibraryPage inherits VerticalLayout {
    padding: Theme.page-padding;
    padding-top: 4px;
    padding-bottom: 10px;
    spacing: 10px;

    if AppState.folder == "": EmptyState {
        icon: Icons.captions;
        icon-size: 64px;
        title: @tr("Subtitles for your videos");
        subtitle: @tr("Choose a folder or some videos, or drop them on this window. SubMagician finds the subtitle made for each file in your languages, fixes its text and timing, and saves it next to the video.");
        Button {
            text: @tr("Choose folder…");
            icon: Icons.folder-open;
            colorize-icon: true;
            primary: true;
            clicked => { AppState.choose-folder(); }
        }
        Button {
            text: @tr("Open videos…");
            icon: Icons.video;
            colorize-icon: true;
            clicked => { AppState.choose-videos(); }
        }
    }

    if AppState.folder != "": HorizontalLayout {
        spacing: 8px;
        if !AppState.busy: HelpButton {
            text: @tr("Get subtitles for all");
            icon: Icons.download;
            primary: true;
            enabled: AppState.files.length > 0;
            help: @tr("Finds the best subtitle in your languages for every video, saves it next to the video and syncs it to the audio. Videos that already have one are skipped (Settings → Subtitles).");
            clicked => { AppState.download-all(); }
        }
        if !AppState.busy: HelpButton {
            text: @tr("Search all");
            icon: Icons.search;
            enabled: AppState.files.length > 0;
            help: @tr("Only looks: every video shows how many subtitles the sources have. Nothing is downloaded.");
            clicked => { AppState.search-all(); }
        }
        if AppState.busy: Button {
            text: @tr("Stop");
            icon: Icons.stop;
            colorize-icon: true;
            clicked => { AppState.stop(); }
        }
        Rectangle { horizontal-stretch: 1; }
        CheckBox {
            text: @tr("Only videos without a subtitle");
            checked <=> AppState.only-missing;
        }
    }

    if AppState.folder != "": HorizontalLayout {
        spacing: 10px;
        vertical-stretch: 1;

        Card {
            horizontal-stretch: 1;
            inner-padding: 4px;
            inner-spacing: 0px;
            if AppState.files.length == 0 && !AppState.busy: EmptyState {
                icon: Icons.video;
                icon-size: 40px;
                title: @tr("No videos here");
                subtitle: AppState.recursive ? @tr("This folder and its subfolders have no video files.")
                    : @tr("This folder has no video files. Settings → Library can look in subfolders too.");
            }
            if AppState.files.length > 0 || AppState.busy: ListView {
                vertical-stretch: 1;
                for row[i] in AppState.files: FileCard {
                    item: row;
                    height: AppState.only-missing && row.has-wanted ? 0px : 50px;
                    selected: i == AppState.selected-file;
                    clicked => {
                        AppState.selected-file = i;
                        AppState.selected-candidate = -1;
                        AppState.file-selected(i);
                    }
                }
            }
        }

        DetailsPanel {
            width: 380px;
        }
    }
}
